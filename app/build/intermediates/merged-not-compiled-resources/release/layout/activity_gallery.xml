<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- FIXED TOP BAR CONTAINER -->
    <FrameLayout
        android:id="@+id/topBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Normal Header -->
        <LinearLayout
            android:id="@+id/normalTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="36dp"
            android:paddingBottom="8dp"
            android:background="#090A0D">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WorkPlace Media"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTotalCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:text="0 items" />
        </LinearLayout>

        <!-- Selection Header -->
        <LinearLayout
            android:id="@+id/selectionTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="36dp"
            android:paddingBottom="8dp"
            android:background="#1B1E26"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnCloseSelection"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/shape_glass_pill"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvSelectionCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="1 selected"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSelectAll"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Select All"
                android:textColor="#00E676"
                android:textStyle="bold"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnBatchShare"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/shape_glass_pill"
                android:src="@drawable/ic_share"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnBatchDelete"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/shape_glass_pill"
                android:src="@drawable/ic_delete"
                app:tint="#FF5252" />
        </LinearLayout>
    </FrameLayout>

    <!-- HORIZONTAL FILTER CHIP BAR -->
    <HorizontalScrollView
        android:id="@+id/scrollChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:background="#090A0D"
        app:layout_constraintTop_toBottomOf="@id/topBarContainer">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <!-- TIMELINE GRID (Supports Pinch to Resize 2-5 columns) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTimeline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/scrollChips"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- FULLSCREEN DETAIL VIEWER OVERLAY -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="30dp">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerDetail"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Top Controls: Back, Title, Star, Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="36dp"
            android:paddingBottom="12dp"
            android:background="@drawable/gradient_glass_top">

            <ImageButton
                android:id="@+id/btnDetailBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/shape_glass_pill"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="Sample Detail" />

            <!-- Favorite Star Button -->
            <ImageButton
                android:id="@+id/btnDetailFavorite"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/shape_glass_pill"
                android:src="@drawable/ic_star_border"
                app:tint="#FFD700" />

            <!-- Metadata EXIF Inspector Button -->
            <ImageButton
                android:id="@+id/btnDetailInfo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/shape_glass_pill"
                android:src="@drawable/ic_info"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Bottom Action Pill: Restore, Share, Delete -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="32dp"
            android:background="@drawable/shape_glass_pill"
            android:paddingHorizontal="18dp"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnDetailRestore"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_restore"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnDetailShare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_share"
                app:tint="#FFFFFF" />

            <View
                android:id="@+id/detailActionDivider"
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="18dp"
                android:background="#35FFFFFF" />

            <ImageButton
                android:id="@+id/btnDetailDelete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                app:tint="#FF5252" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
